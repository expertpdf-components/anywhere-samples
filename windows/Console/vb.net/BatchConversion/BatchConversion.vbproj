<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFramework Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))"></TargetFramework>
    <RootNamespace>BatchConversion</RootNamespace>
    <AssemblyName>BatchConversion</AssemblyName>
    <StartupObject>BatchConversion.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>

  <ItemGroup>
    <!-- the ExpertPdf Anywhere library with its Windows x64 engines -->
    <PackageReference Include="ExpertPdf.Anywhere.Windows" Version="22.0.0" />
    <Import Include="System" />
    <Import Include="System.Collections.Generic" />
    <Import Include="ExpertPdf.Anywhere.Drawing" />
    <Import Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Include="html\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
