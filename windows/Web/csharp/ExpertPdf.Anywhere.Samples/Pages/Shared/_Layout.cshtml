            <div class="sample-card">
                <form method="post" enctype="multipart/form-data">
                    @RenderBody()
                </form>
                @if (Context.Request.Path.Value.Contains("Index") || (Context.Request.Path.Value.Length == 1))
                {
                    // do not display code in this case
                }
                else
                {
                    try
                    {
                        // the code of the page model, shown below the sample
                        string code = System.IO.File.ReadAllText(System.IO.Path.Combine(Startup.ServerPath, "Pages", this.ViewContext.RouteData.Values["page"].ToString().TrimStart('/') + ".cshtml.cs"));
                        ViewData.Add("Data", code);
                    }
                    catch { }
                }

                @if (ViewData["Data"] != null && ViewData["Data"].ToString().Length > 0)
                {
                    <h2>Sample Code C#</h2>
                    <pre class="code">@ViewData["Data"]</pre>
                }
