<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFramework Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))"></TargetFramework>
    <RootNamespace>ElectronicInvoice</RootNamespace>
    <AssemblyName>ElectronicInvoice</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- The platform package for the target's architecture: Linux ARM64 when publishing with -r linux-arm64
       or building on an arm64 machine, Linux x64 otherwise. Override with -p:AnywherePlatform=Linux.Arm64. -->
  <PropertyGroup>
    <AnywherePlatform Condition="'$(AnywherePlatform)' == '' and '$(RuntimeIdentifier)' == 'linux-arm64'">Linux.Arm64</AnywherePlatform>
    <AnywherePlatform Condition="'$(AnywherePlatform)' == '' and '$(RuntimeIdentifier)' != ''">Linux</AnywherePlatform>
    <AnywherePlatform Condition="'$(AnywherePlatform)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">Linux.Arm64</AnywherePlatform>
    <AnywherePlatform Condition="'$(AnywherePlatform)' == ''">Linux</AnywherePlatform>
  </PropertyGroup>

  <ItemGroup>
    <!-- the ExpertPdf Anywhere library with its Linux engines -->
    <PackageReference Include="ExpertPdf.Anywhere.$(AnywherePlatform)" Version="22.0.0" />
    <!-- Fonts for every language: a Linux server or container often has none, and without them
         Arabic, Chinese, Japanese, Korean, Hindi, Thai and other scripts print as empty boxes. -->
    <PackageReference Include="ExpertPdf.Anywhere.Fonts" Version="22.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="invoice.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="factur-x.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
