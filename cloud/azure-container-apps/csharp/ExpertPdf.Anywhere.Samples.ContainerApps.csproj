<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>ExpertPdf.Anywhere.Samples.ContainerApps</AssemblyName>
    <RootNamespace>ExpertPdf.Anywhere.Samples.ContainerApps</RootNamespace>
  </PropertyGroup>

  <!-- The ExpertPdf Anywhere library with its Linux x64 engines (Container Apps runs x86-64 containers).
       ExpertPdf.Anywhere.Fonts adds fonts for every language: the container image has no fonts installed. -->
  <ItemGroup>
    <PackageReference Include="ExpertPdf.Anywhere.Linux" Version="22.0.0" />
    <PackageReference Include="ExpertPdf.Anywhere.Fonts" Version="22.0.0" />
  </ItemGroup>

  <!-- Your own fonts: put .ttf / .otf files in the fonts folder; they are copied next to the app
       and ExpertPdf Anywhere uses them. -->
  <ItemGroup>
    <None Include="fonts\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
