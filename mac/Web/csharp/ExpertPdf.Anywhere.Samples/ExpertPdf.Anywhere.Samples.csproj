<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFramework Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))"></TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>ExpertPdf.Samples</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- the ExpertPdf Anywhere library with its macOS (Apple Silicon) engines -->
    <PackageReference Include="ExpertPdf.Anywhere.MacOS" Version="22.0.0" />
  </ItemGroup>

  <!-- The sample code shown under each page is read from the page's .cshtml.cs source at run time;
       copy the page sources into the publish output so a deployed site shows it too. -->
  <Target Name="CopySamplePageSourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <SamplePageSource Include="Pages\*.cshtml.cs" />
    </ItemGroup>
    <Copy SourceFiles="@(SamplePageSource)" DestinationFolder="$(PublishDir)Pages" SkipUnchangedFiles="true" />
  </Target>

</Project>
