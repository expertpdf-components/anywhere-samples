<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFramework Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))"></TargetFramework>
    <RootNamespace>MultithreadedPerformance</RootNamespace>
    <AssemblyName>MultithreadedPerformance</AssemblyName>
    <StartupObject>MultithreadedPerformance.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>

  <ItemGroup>
    <!-- the ExpertPdf Anywhere library with its macOS (Apple Silicon) engines -->
    <PackageReference Include="ExpertPdf.Anywhere.MacOS" Version="22.0.0" />
    <Import Include="System" />
    <Import Include="System.Collections.Generic" />
    <Import Include="ExpertPdf.Anywhere.Drawing" />
    <Import Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Include="sample.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
