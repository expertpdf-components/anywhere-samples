<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFramework Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))"></TargetFramework>
    <RootNamespace>ExtractPdfImages</RootNamespace>
    <AssemblyName>ExtractPdfImages</AssemblyName>
    <StartupObject>ExtractPdfImages.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- the ExpertPdf Anywhere library with its macOS (Apple Silicon) engines -->
    <PackageReference Include="ExpertPdf.Anywhere.MacOS" Version="22.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="sample.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="sample-protected.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
