<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <TargetFramework Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))"></TargetFramework>
    <RootNamespace>PdfSecurityFeatures</RootNamespace>
    <AssemblyName>PdfSecurityFeatures</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System" />
    <Import Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- the ExpertPdf Anywhere library with its macOS (Apple Silicon) engines -->
    <PackageReference Include="ExpertPdf.Anywhere.MacOS" Version="22.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- the input files of the sample, next to the executable -->
    <None Include="report.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
